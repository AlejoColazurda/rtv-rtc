PORT=8080

# --- Base de datos ---
# Dejá DATABASE_URL vacío para correr en MODO LOCAL: la app guarda y lee
# todo desde backend/data/invitations.json. Arranque limpio, sin red, sin errores.
#
# Para usar Supabase, completá la URL abajo y reiniciá el backend:
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# (el proyecto Supabase anterior ya no resuelve; usar credenciales/host nuevos)
DATABASE_URL=
